# Postgres connection string used by Prisma at runtime
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet?schema=public

# Secret used to sign JWTs. MUST be overridden in production.
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: token TTL in seconds (default 30 days)
JWT_EXPIRES_IN=2592000

# HTTP port the API listens on
PORT=3000